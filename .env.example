# NEXUS AI - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to Git

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/nexus_ai
# Docker: postgresql://postgres:yourpassword@db:5432/nexus_ai

# ============================================================
# AUTH / SECURITY
# ============================================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
FRONTEND_URL=http://localhost:5173
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
LLM_PROVIDER=
LLM_API_KEY=

# Server-only Google key for the Routes API. Do not put this in frontend code.
GOOGLE_MAPS_SERVER_KEY=

# ============================================================
# FILE STORAGE
# ============================================================
UPLOAD_DIR=storage/uploads
THUMBNAIL_DIR=storage/thumbnails
PROCESSED_DIR=storage/processed_images
TEMP_DIR=storage/temporary
MAX_UPLOAD_SIZE_MB=20

# ============================================================
# CORS (comma-separated origins; use * only in development)
# ============================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# AI MODEL PATHS (optional - falls back to heuristic if missing)
# ============================================================
YOLO_MODEL_PATH=ai_engine/models/detection/yolov8n_rdd2022.pt
SEVERITY_MODEL_PATH=ai_engine/models/severity/severity_model.json
EMBEDDINGS_MODEL=all-MiniLM-L6-v2

# ============================================================
# GEOGRAPHIC / OSM
# ============================================================
# Nominatim instance URL (use your own or the public one)
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
# User-Agent string required by Nominatim usage policy
OSM_USER_AGENT=NEXUS-AI/1.0 (your-email@example.com)
# Overpass API endpoint
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Default map center (lat, lon) - example: Bengaluru
DEFAULT_LAT=12.9716
DEFAULT_LON=77.5946
DEFAULT_ZOOM=12

# ============================================================
# DUPLICATE DETECTION THRESHOLDS
# ============================================================
DUPLICATE_THRESHOLD=0.75
RELATED_THRESHOLD=0.55
IMAGE_HASH_THRESHOLD=0.80

# ============================================================
# SEVERITY THRESHOLDS
# ============================================================
SEVERITY_CRITICAL=0.75
SEVERITY_HIGH=0.50
SEVERITY_MEDIUM=0.25

# ============================================================
# VERIFICATION CONFIDENCE
# ============================================================
VERIFICATION_CONFIRMED=0.75
VERIFICATION_LIKELY=0.55
VERIFICATION_REVIEW=0.35

# ============================================================
# APPLICATION
# ============================================================
APP_ENV=development
DEBUG=true
LOG_LEVEL=info
BACKEND_PORT=8000
FRONTEND_PORT=5173
