# NEXUS AI - Environment Configuration
# Copy this file to .env and fill in your values

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://nexus_user:nexus_pass@localhost:5432/nexus_db

# ── JWT Authentication ──────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-64-char-random-string-before-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── File Uploads ────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# ── AI Models ───────────────────────────────────────────────────────────────
YOLO_MODEL_PATH=./models/yolov8n_infrastructure.pt
SEVERITY_MODEL_PATH=./models/severity_xgb.pkl
EMBEDDING_MODEL=all-MiniLM-L6-v2
